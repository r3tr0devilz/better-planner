# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# console.anthropic.com → API keys
# Used unless CAPTURE_LLM_PROVIDER=ollama below.
ANTHROPIC_API_KEY=

# Capture parsing provider — leave unset (or "anthropic") to use Claude.
# Set to "ollama" to parse captures with a local model instead — only works
# when Ollama is reachable from wherever this app is running (i.e. not on a
# deployed server unless you tunnel to it).
# CAPTURE_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
